# =================================================================
# AgentGuard AI SOC - Environment Configuration (.env.example)
# Copy this file to .env:  cp .env.example .env
# =================================================================

# Security (Required: 32+ character secret; backend refuses to start if empty)
HMAC_SECRET=your-secure-random-hmac-secret-min-32-chars-long
SECRET=your-secure-random-hmac-secret-min-32-chars-long
TOKEN_TTL_SECONDS=60
SIMULATION=true

# Operation Modes
DEMO_MODE=guarded       # guarded | naive
LIVE_MODE=false         # true | false (enables live log tailing and stub site integration)
TOOL_BACKEND=mock       # mock | portal (in portal mode, actions hit SITE_URL/admin)

# Endpoints & Database
TOOL_URL=http://localhost:8001
SITE_URL=http://localhost:8002
SITE_ADMIN_KEY=demo-admin-key-supersecret
DB_URL=sqlite:///./agentguard.db
DASHBOARD_URL=http://localhost:5173

# Site Log Paths (for live collector)
SITE_LOG_PATH=./site_logs/auth.log
SITE_ACCESS_LOG_PATH=./site_logs/access.log
SITE_DATA_LOG_PATH=./site_logs/data.log

# LLM / AI Configuration
LLM_PROVIDER=gemini      # gemini | none | openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
GEMINI_API_KEY=
ALLOW_UNREVIEWED_LANGS=false

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=

# Automatic Inputs (Mail & DNS Watchers)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
MAIL_DROP_DIR=./mail_drop
DNS_LOG_PATH=./dns_logs/dns.log
